# Copy this file to .env.local and fill in your values.
# .env.local is gitignored — never commit it.

# Cloudflare Worker proxy URL — the worker holds the API key server-side.
# After deploying the worker: wrangler deploy (in worker/)
# The worker URL is printed on deploy and visible in the Cloudflare dashboard.
# Format: https://build-with-ai-proxy.YOUR_SUBDOMAIN.workers.dev
VITE_WORKER_URL=https://build-with-ai-proxy.YOUR_SUBDOMAIN.workers.dev
