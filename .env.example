# .env.example — copy to .env and fill in values
# Never commit .env — only .env.example belongs in the repo

# Anthropic API key — get from console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Model selection
# Default executor (cheap — use for all atomic tasks)
EXECUTOR_MODEL=claude-haiku-4-5-20251001
# Default orchestrator (reasoning + planning)
ORCHESTRATOR_MODEL=claude-sonnet-4-6

# Budget limits
SESSION_BUDGET_USD=5.00
PER_CALL_BUDGET_USD=0.10
PER_CALL_TOKEN_LIMIT=50000

# Rate limiting
REQUESTS_PER_MINUTE=20

# Logging
LOG_LEVEL=INFO
# LOG_FORMAT options: json (production), text (development)
LOG_FORMAT=json

# AWS (optional — leave unset to use instance role or ~/.aws/credentials)
AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
